{
  "name": "merck-hcp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "commit": "cz",
    "lint": "ng lint",
    "start": "ng serve",
    "build": "ng build",
    "postinstall": "husky",
    "format-fix": "prettier --write .",
    "format-check": "prettier --check .",
    "build:qa": "ng build --configuration qa",
    "build:dev": "ng build --configuration dev",
    "build:uat": "ng build --configuration uat",
    "build:prod": "ng build --configuration prod",
    "generate-sprite": "npx tsx generate-svg-sprite.ts",
    "visualize": "ng build --configuration=analyze-bundle --verbose && esbuild-visualizer --metadata dist/lantheus-portal/stats.json --filename dist/lantheus-portal/stats.html"
  },
  "private": true,
  "packageManager": "yarn@4.12.0",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@primeng/themes": "^21.0.3",
    "chart.js": "^4.5.1",
    "crypto-js": "^4.2.0",
    "jwt-decode": "^4.0.0",
    "ngx-extended-pdf-viewer": "^25.6.4",
    "ngx-toastr": "^19.1.0",
    "primeng": "^21.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@types/crypto-js": "^4.2.2",
    "angular-eslint": "21.1.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.29.0",
    "vite-plugin-svg-spritemap": "^1.0.13",
    "vitest": "^4.0.8"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "**/*.{js,ts,html,scss}": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  }
}
